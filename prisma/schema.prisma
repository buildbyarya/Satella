generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?   @db.Text
  nickname      String?
  gender        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts             Account[]
  sessions             Session[]
  homeMembership       HomeMember?
  pendingHomes         PendingHome[]      @relation("CreatedPendingHomes")
  joinedPendingHomes   PendingHome[]      @relation("JoinedPendingHomes")
  noteBooks            NoteBook[]
  sentQuickNotes       QuickNote[]        @relation("QuickNoteSender")
  receivedQuickNotes   QuickNote[]        @relation("QuickNoteRecipient")
  watchInvitesSent     WatchInvite[]      @relation("WatchInviteSender")
  watchInvitesReceived WatchInvite[]      @relation("WatchInviteRecipient")
  watchMemberships     WatchRoomMember[]
  watchSetting         WatchSetting?
  sentChatMessages     ChatMessage[]      @relation("ChatMessageSender")
  chatMediaViews       ChatMediaView[]
  chatReads            ChatRead[]
  chatReactions        ChatReaction[]
  chatPreference       ChatPreference?
  deletionRequestsSent     HomeDeletionRequest[] @relation("HomeDeletionRequester")
  deletionRequestsReceived HomeDeletionRequest[] @relation("HomeDeletionPartner")
}

model Home {
  id         String   @id @default(cuid())
  name       String
  inviteCode String   @unique
  createdAt  DateTime @default(now())

  members     HomeMember[]
  library     LibraryVideo[]
  playlists   Playlist[]
  noteBooks   NoteBook[]
  quickNotes  QuickNote[]
  watchRooms  WatchRoom[]
  watchInvites WatchInvite[]
  chatMessages ChatMessage[]
  chatSetting ChatSetting?
  chatReads ChatRead[]
  chatPreferences ChatPreference[]
  calendarEvents CalendarEvent[]
  drawingSwapGame DrawingSwapGame?
  deletionRequests HomeDeletionRequest[]
}

model PendingHome {
  id         String   @id @default(cuid())
  inviteCode String   @unique
  creatorId  String
  partnerId  String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  creator User  @relation("CreatedPendingHomes", fields: [creatorId], references: [id], onDelete: Cascade)
  partner User? @relation("JoinedPendingHomes", fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([inviteCode])
}

model HomeMember {
  id       String   @id @default(cuid())
  userId   String   @unique
  homeId   String
  nickname String?

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  home      Home       @relation(fields: [homeId], references: [id], onDelete: Cascade)
  playlists Playlist[]
  joinedAt   DateTime   @default(now())

  @@unique([userId, homeId])
}

model LibraryVideo {
  id        String          @id @default(cuid())
  homeId    String
  videoId   String
  title     String?
  thumbnail String?
  channel   String?
  type      LibraryVideoType
  createdAt DateTime        @default(now())

  home Home @relation(fields: [homeId], references: [id], onDelete: Cascade)

  @@unique([homeId, videoId, type])
  @@index([homeId])
  @@index([type])
}

enum LibraryVideoType {
  WATCH_LATER
  LIKED
}

model Playlist {
  id            String              @id @default(cuid())
  name          String
  type          PlaylistType
  visibility    PlaylistVisibility
  systemType    SystemPlaylistType?
  homeId        String?
  homeMemberId  String?

  home       Home?       @relation(fields: [homeId], references: [id], onDelete: Cascade)
  homeMember HomeMember? @relation(fields: [homeMemberId], references: [id], onDelete: Cascade)
  videos     PlaylistVideo[]

  createdAt DateTime @default(now())

  @@index([homeId])
  @@index([homeMemberId])
  @@index([systemType])
}

model PlaylistVideo {
  id             String   @id @default(cuid())
  playlistId     String
  youtubeVideoId String
  addedAt        DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@unique([playlistId, youtubeVideoId])
}

enum PlaylistType {
  SYSTEM
  CUSTOM
}

enum SystemPlaylistType {
  WATCH_LATER
  LIKED_VIDEOS
}

enum PlaylistVisibility {
  PERSONAL
  SHARED
}

model NoteBook {
  id              String   @id @default(cuid())
  homeId          String
  ownerId         String
  type            String
  content         String   @default("")
  checkboxMode    Boolean  @default(false)
  isPrivate       Boolean  @default(false)
  backgroundImage String?
  updatedAt       DateTime @updatedAt

  home  Home @relation(fields: [homeId], references: [id], onDelete: Cascade)
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([homeId, ownerId, type])
  @@index([homeId, type])
}

model QuickNote {
  id          String   @id @default(cuid())
  homeId      String
  senderId    String
  recipientId String
  content     String   @db.Text
  readCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  home      Home @relation(fields: [homeId], references: [id], onDelete: Cascade)
  sender    User @relation("QuickNoteSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("QuickNoteRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([homeId, senderId])
  @@index([recipientId])
}

enum ChatMessageKind {
  TEXT
  IMAGE
  VOICE
  VIDEO
}

model ChatMessage {
  id             String          @id @default(cuid())
  homeId         String
  senderId       String
  content        String          @db.Text
  kind           ChatMessageKind @default(TEXT)
  replyToId      String?
  pinned         Boolean         @default(false)
  mediaMime      String?
  mediaData      String?         @db.Text
  mediaExpiresAt DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  editedAt       DateTime?
  fontSize       Int?
  textColor      String?
  fontFamily     String?
  bubbleColor    String?

  home     Home         @relation(fields: [homeId], references: [id], onDelete: Cascade)
  sender   User         @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  replyTo  ChatMessage? @relation("ChatMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies  ChatMessage[] @relation("ChatMessageReplies")
  views    ChatMediaView[]
  reactions ChatReaction[]

  @@index([homeId, createdAt])
  @@index([replyToId])
}

model ChatMediaView {
  id        String      @id @default(cuid())
  messageId String
  userId    String
  views     Int         @default(0)
  updatedAt DateTime    @updatedAt

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

model ChatReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model ChatRead {
  id         String   @id @default(cuid())
  homeId     String
  userId     String
  lastReadAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  home Home @relation(fields: [homeId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([homeId, userId])
}

model ChatSetting {
  id         String   @id @default(cuid())
  homeId     String   @unique
  background String   @default("linear-gradient(135deg,#160b2e,#050505,#2a0a22)")
  backgroundImage String? @db.Text
  updatedAt  DateTime @updatedAt

  home Home @relation(fields: [homeId], references: [id], onDelete: Cascade)
}

model ChatPreference {
  id         String   @id @default(cuid())
  homeId     String
  userId     String   @unique
  fontSize   Int      @default(16)
  textColor  String   @default("#ffffff")
  fontFamily String   @default("system-ui")
  bubbleColor String  @default("#7c3aed")
  updatedAt  DateTime @updatedAt

  home Home @relation(fields: [homeId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([homeId])
}

model CalendarEvent {
  id          String   @id @default(cuid())
  homeId      String
  title       String
  description String   @default("")
  startAt     DateTime
  endAt       DateTime?
  allDay      Boolean  @default(false)
  color       String   @default("#f9a8d4")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  home Home @relation(fields: [homeId], references: [id], onDelete: Cascade)

  @@index([homeId, startAt])
}

model DrawingSwapGame {
  id          String   @id @default(cuid())
  homeId      String   @unique
  status      String   @default("LOBBY")
  startedAt   DateTime?
  phaseEndsAt DateTime?
  drawingA    String?  @db.Text
  drawingB    String?  @db.Text
  round       Int      @default(0)
  durationSec Int      @default(225)
  swapSec     Int      @default(45)
  updatedAt   DateTime @updatedAt

  home Home @relation(fields: [homeId], references: [id], onDelete: Cascade)
}

model HomeDeletionRequest {
  id              String   @id @default(cuid())
  homeId          String
  requesterId     String
  partnerId       String
  partnerDecision String   @default("PENDING")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  respondedAt     DateTime?

  home      Home @relation(fields: [homeId], references: [id], onDelete: Cascade)
  requester User @relation("HomeDeletionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  partner   User @relation("HomeDeletionPartner", fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([homeId])
  @@index([partnerId, partnerDecision])
  @@index([requesterId])
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model WatchRoom {
  id           String   @id @default(cuid())
  homeId       String
  videoId      String
  position     Float    @default(0)
  playing      Boolean  @default(false)
  volume       Int      @default(100)
  playbackRate Float    @default(1)
  version      Int      @default(0)
  lastActionAt DateTime @default(now())
  createdAt    DateTime @default(now())

  home         Home               @relation(fields: [homeId], references: [id], onDelete: Cascade)
  members      WatchRoomMember[]
  invites      WatchInvite[]
  chatMessages WatchChatMessage[]

  @@index([homeId])
}

model WatchRoomMember {
  id         String    @id @default(cuid())
  roomId     String
  userId     String
  joinedAt   DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  leftAt     DateTime?

  room WatchRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
}

model WatchChatMessage {
  id             String   @id @default(cuid())
  roomId         String
  senderId       String
  senderNickname String
  content        String   @db.Text
  createdAt      DateTime @default(now())

  room WatchRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
}

model WatchInvite {
  id            String    @id @default(cuid())
  homeId        String
  roomId        String
  senderId      String
  recipientId   String
  videoId       String
  position      Float     @default(0)
  expiresAt     DateTime
  status        String    @default("PENDING")
  customMessage String?
  createdAt     DateTime  @default(now())
  respondedAt   DateTime?
  replySeenAt   DateTime?

  home      Home      @relation(fields: [homeId], references: [id], onDelete: Cascade)
  room      WatchRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender    User      @relation("WatchInviteSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User      @relation("WatchInviteRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, status])
  @@index([expiresAt])
}

model WatchSetting {
  id            String @id @default(cuid())
  userId        String @unique
  expiryMinutes Int    @default(10)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}